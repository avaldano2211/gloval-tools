# ── QuickBooks Online (Intuit Developer → tu app → Keys & credentials) ──
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con una Redirect URI registrada en Intuit.
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback
# sandbox | production (las keys de producción son distintas a las de sandbox)
QBO_ENVIRONMENT=sandbox

# Contraseña para entrar a /admin/quickbooks
QBO_ADMIN_PASSWORD=
# Secreto aleatorio ≥ 32 caracteres para cifrar cookies (openssl rand -base64 48)
QBO_SESSION_SECRET=
